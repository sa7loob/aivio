# إعدادات بوت العميل. انسخه إلى ../../clients/<اسم>.bot.env ثم عبّئه (لا يُرفع لـ git).
# أي قيمة فيها مسافات تُكتب بين " ".
# deploy-bot.sh يقرأه ويكتب الإعدادات في قاعدة العميل ويُنشئ الـ credentials في n8n.

BUSINESS_NAME="حلويات شهرزاد"

# من Meta (App Dashboard > WhatsApp > API Setup / Configuration، و App Settings > Basic)
PHONE_NUMBER_ID=
META_APP_SECRET=
# كلمة تختارها أنت وتكتبها نفسها في خانة Verify token عند ربط الـ webhook في Meta: openssl rand -hex 16
META_VERIFY_TOKEN=
# System User token دائم بصلاحية whatsapp_business_messaging
WHATSAPP_TOKEN=

# مفتاح OpenAI (مشروع خاص بهذا العميل بسقف إنفاق)
OPENAI_API_KEY=

# هاتف صاحب المحل للتنبيهات بالمفتاح الدولي، مثل "218 91 234 5678" (المسافات و + تُحذف تلقائياً)
OWNER_PHONE=""
# اسم قالب Utility المعتمد في WhatsApp Manager لتنبيه المالك (انظر README القالب).
# اتركه فارغاً لإرسال رسالة نصية عادية: تصل فقط إذا راسل المالك رقم المحل خلال آخر 24 ساعة.
OWNER_TEMPLATE_NAME=
OWNER_TEMPLATE_LANG=ar

# معلومات المحل التي يقولها البوت للزبائن
OPENING_HOURS="كل يوم من 9 الصبح لين 11 الليل، الجمعة من بعد العصر"
ADDRESS="طرابلس"
DELIVERY_INFO="التوصيل داخل طرابلس، الرسوم حسب المنطقة ويأكدها المحل"
ORDER_NOTICE="التورتات والصواني تُطلب قبل 24 ساعة على الأقل"
EXTRA_INSTRUCTIONS=

# اختياري (الافتراضي مناسب)
CHAT_MODEL=gpt-4o
TRANSCRIPTION_MODEL=gpt-4o-transcribe
# للتجربة المحلية فقط (agency/dev): وجّه الطلبات للبديل المحلي. في الإنتاج اتركهما فارغين.
GRAPH_BASE_URL=
OPENAI_BASE_URL=
