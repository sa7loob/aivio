# انسخه إلى .env ثم عبّئ القيم:  cp .env.example .env && chmod 600 .env

# النطاق الأساسي: كل عميل يأخذ <اسم>.BASE_DOMAIN (مثل hajj.bots.example.ly)
# المطلوب في DNS سجل واحد: A  *.bots.example.ly  =>  IP السيرفر
BASE_DOMAIN=bots.example.ly
# بريدك لتنبيهات Let's Encrypt
ACME_EMAIL=you@example.ly

# كلمة مرور postgres الرئيسية: openssl rand -hex 24
POSTGRES_PASSWORD=

# الدخول الإضافي لمحرر n8n (قبل شاشة دخول n8n نفسها)
EDITOR_USER=agency
# الناتج من: docker run --rm -it caddy:2.11 caddy hash-password   (يسألك عن كلمة المرور؛ لا تبقى في history)
# ضعه بين علامتي ' ' لأن فيه رموز $
EDITOR_HASH='$2a$14$replace.with.caddy.hash-password.output'

TZ=Africa/Tripoli
# سجل التنفيذ (فيه رسائل الزبائن) يُحذف بعد هذه المدة بالساعات: 336 = 14 يوماً
EXECUTIONS_MAX_AGE_HOURS=336
# سقف ذاكرة كل نسخة n8n
N8N_MEM_LIMIT=1g
