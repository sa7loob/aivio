ENV=dev
LOG_LEVEL=INFO

# ---- Postgres (docker-compose)
POSTGRES_SUPERUSER_PASSWORD=change-me-super
APP_OWNER_PASSWORD=change-me-owner
APP_USER_PASSWORD=change-me-user
APP_ADMIN_PASSWORD=change-me-admin

# Alembic + سكربتات الإدارة (دور المالك) — من جهازك خارج Docker
MIGRATIONS_DATABASE_URL=postgresql+psycopg://app_owner:change-me-owner@127.0.0.1:5432/agentdb
# التطبيق (API + Worker) — دور التشغيل. داخل Docker يُستبدل تلقائياً بعنوان خدمة postgres
DATABASE_URL=postgresql+asyncpg://app_user:change-me-user@127.0.0.1:5432/agentdb

# ---- Meta App (developers.facebook.com > App > Settings > Basic)
META_APP_SECRET=
# أي نص عشوائي طويل، ونفس القيمة تُكتب في إعداد Webhook في لوحة Meta
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0

# ---- تشفير توكنات القنوات
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- يُستخدم مرة واحدة مع scripts/register_whatsapp_channel.py (لا يُخزّن نصاً صريحاً)
WHATSAPP_ACCESS_TOKEN=

# ---- Worker
REPLY_DEBOUNCE_SECONDS=4

# ---- LLM (المرحلة 4)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
# LLM_TEMPERATURE=0.3        # اتركه فارغاً لموديلات reasoning التي لا تقبله
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
# قالب واتساب لإشعار المبيعات (Utility) — 4 متغيرات: الاسم، الهاتف، البرنامج، المسافرون
LEAD_TEMPLATE_NAME=new_lead
LEAD_TEMPLATE_LANGUAGE=ar

# ---- لوحة الإدارة الداخلية (المرحلة 4.5)
ADMIN_DATABASE_URL=postgresql+asyncpg://app_admin:change-me-admin@127.0.0.1:5432/agentdb
# سر HMAC لرموز القسائم — يُولَّد مرة واحدة ولا يُغيَّر (تغييره يبطل كل القسائم غير المستخدمة)
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VOUCHER_PEPPER=

# ---- الهوية والربط الذاتي (المرحلة 5)
# أصل الواجهة المسموح له بطلبات POST عبر الكوكي (CSRF). نفس نطاق الـ API إذا استُخدمت صفحة /connect
WEB_ALLOWED_ORIGINS=["https://api.example.ly"]
COOKIE_SECURE=true
# خطة التسجيل الذاتي: أنشئها أولاً من لوحة الإدارة (POST /admin/plans) بنفس الكود
SIGNUP_PLAN_CODE=starter
SIGNUP_TRIAL_DAYS=14
# من لوحة تطبيق Meta: WhatsApp > Embedded Signup، و Facebook Login for Business > Configurations
# META_APP_ID يُستخدم أيضاً في فحص صلاحية التوكنات (debug_token) وتمييز echo البوت
META_APP_ID=
META_ES_CONFIG_ID=
META_FB_LOGIN_CONFIG_ID=
CHANNEL_HEALTH_EVERY_HOURS=6
# الرابط العام للـ API: يُستخدم في رابط حالة حذف البيانات لـ Meta وروابط إعادة تعيين كلمة المرور
PUBLIC_BASE_URL=https://api.example.ly
PASSWORD_RESET_TTL_HOURS=24
